# PostgreSQL
POSTGRES_DB=vuln_dashboard
POSTGRES_USER=vuln_user
# REQUIRED. The stack refuses to start without it -- there is deliberately no
# default, because a default password plus a published port is how a database
# ends up reachable with a credential anyone can read in the repo.
POSTGRES_PASSWORD=change-me-before-first-boot
# Server. Published on 127.0.0.1 only -- the API has no authentication and the
# browser reaches it same-origin through nginx.
PORT=3001

# Origins allowed to call the API cross-origin. Leave empty unless you serve
# the client from somewhere other than the bundled nginx; the default permits
# http://localhost:3000 and http://127.0.0.1:3000 only.
ALLOWED_ORIGINS=

# Client
CLIENT_PORT=3000

# Optional NVD API key. Without one NVD allows 5 requests / 30s; with one, 50.
NVD_API_KEY=

# How far back each NVD poll looks for modified CVEs, in days (NVD caps the
# window at 120).
NVD_LOOKBACK_DAYS=30

# Page cap per NVD poll (2000 records per page). Raise this, ideally alongside
# NVD_API_KEY, to backfill more history per cycle.
NVD_MAX_PAGES=5

# MITRE has no bulk endpoint, so each cycle enriches at most this many CVEs
# one request at a time.
MITRE_ENRICH_LIMIT=25

# Automatic fetch interval in hours
POLL_INTERVAL_HOURS=6
